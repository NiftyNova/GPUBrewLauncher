#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
#include "launcher-state.glsl"
#include "hb.glsl"
void launchSelection(){
 if(c.state.x<c.reserved.w)c.transition.y=1.0;
 else c.state.w=1u;
}
void main(){
 uint buttons=hbButtons(),pressed=hbPressed();
 c.motion.x+=1.0/60.0;c.state.z++;
 vec2 optical=vec2(0);bool leftMouse=false,rightMouse=false;
 if(c.game.x==0u){c.flow.xy=vec2(960,540);c.game.x=1u;}
 vec2 stickPointer=hbStick(true);
 if(length(stickPointer)>0.0){
  c.flow.xy=clamp(c.flow.xy+vec2(stickPointer.x,-stickPointer.y)*18.0,vec2(24),vec2(1896,1056));
  c.game.y=1u;
 }
 if(hbHas(HB_JOY_MOUSE)){
  for(uint player=0u;player<8u;player++){
   leftMouse=leftMouse||(hbJoyMouseAttributes(player,0u)&2u)!=0u;
   rightMouse=rightMouse||(hbJoyMouseAttributes(player,1u)&2u)!=0u;
   for(uint side=0u;side<2u;side++)optical+=hbJoyMouseDelta(player,side,c.rows[player*2u+side]);
  }
  c.flow.xy=clamp(c.flow.xy+optical*1.5,vec2(24),vec2(1896,1056));
 }

 c.stats.w=((leftMouse||rightMouse)||c.game.y!=0u)?1u:0u;
 c.motion.w=max(0.0,c.motion.w-1.0/60.0);
 if(c.transition.y!=0.0){
  c.transition.x=min(1.0,c.transition.x+1.0/15.0);
  if(c.transition.x>=1.0)c.reserved.y=c.state.x+1u;
  c.state.y=buttons;return;
 }
 c.transition.x=max(0.0,c.transition.x-1.0/15.0);
 bool connected=(c.raw[2].x&1u)!=0u;
 uint count=min(c.library.x,32u);
 if(count==0u){c.state.x=0u;c.state.w=0u;}else c.state.x=min(c.state.x,count-1u);
 if(connected){
  float stick=float(int(c.raw[1].y))/32767.0;int direction=0;
  if((pressed&(1u<<13))!=0u)direction=-1;
  if((pressed&(1u<<15))!=0u)direction=1;
  if(abs(stick)>.55&&c.motion.w<=0.0){direction=stick>0.0?-1:1;c.motion.w=.22;}
  if(direction!=0&&count>0u&&c.state.w==0u)c.state.x=uint((int(c.state.x)+direction+int(count))%int(count));
  if((pressed&2u)!=0u)c.state.w=0u;
 }
 if(c.stats.w!=0u&&c.state.w==0u){
  bool click=(pressed&512u)!=0u||(leftMouse&&(pressed&HB_L)!=0u)||(rightMouse&&(pressed&HB_R)!=0u);
  // The appearance switch sits next to Back.  Holding the mouse button or ZR
  // lets the pointer drag it; it snaps to the nearer side.
  bool sliderDown=leftMouse||rightMouse||(buttons&512u)!=0u;
  if(sliderDown&&abs(c.flow.xy.x-1804.0)<=92.0&&abs(c.flow.xy.y-1017.0)<=24.0)c.reserved.x=c.flow.xy.x>=1804.0?1u:0u;
  if(length(optical)>0.0||length(stickPointer)>0.0||click){
   uint page=(c.state.x/3u)*3u;
   for(uint row=0u;row<3u;row++){
    uint index=page+row;if(index>=count)break;
    vec2 q=abs(c.flow.xy-vec2(960,551.0+float(row)*151.0))-vec2(642,44);
    if(min(max(q.x,q.y),0.0)+length(max(q,0.0))-18.0<=0.0){c.state.x=index;if(click)launchSelection();}
   }
  }
  if(click&&distance(c.flow.xy,vec2(1660,179))<=65.0&&c.refresh.x<=0.0){c.refresh.x=1.0;c.refresh.y=0.0;c.refresh.z+=1.0;}
 }
 bool touching=c.touch[2]==1u&&(c.touch[6]&2u)==0u;
 if(touching){
  vec2 p=vec2(c.touch[8],c.touch[9])*1.5;
  if(c.library.w==0u&&distance(p,vec2(1660,179))<=65.0&&c.state.w==0u&&c.refresh.x<=0.0){c.refresh.x=1.0;c.refresh.y=0.0;c.refresh.z+=1.0;}
  if(c.state.w==0u&&p.x>=1712.0&&p.x<=1896.0&&p.y>=993.0&&p.y<=1041.0)c.reserved.x=p.x>=1804.0?1u:0u;
  uint page=(c.state.x/3u)*3u;
  if(c.state.w==0u)for(uint row=0u;row<3u;row++){
   uint index=page+row;if(index>=count)break;
   vec2 q=abs(p-vec2(960,551.0+float(row)*151.0))-vec2(642,44);
   float d=min(max(q.x,q.y),0.0)+length(max(q,0.0))-18.0;
   if(d<=0.0){c.state.x=index;if(index<c.reserved.w&&c.library.w==0u)launchSelection();}
  }
 }
 c.library.w=touching?1u:0u;
 // A confirms the highlighted row when the pointer is hidden.  Once the
 // pointer is visible it behaves like a click at the pointer, so it cannot
 // launch whatever app happened to be hovered from a blank part of the screen.
 // Over the appearance switch it toggles the theme instead of launching.
 if((pressed&1u)!=0u&&count>0u&&c.state.w==0u){
  bool pointerActive=c.stats.w!=0u;
  bool overSwitch=pointerActive&&abs(c.flow.xy.x-1804.0)<=92.0&&abs(c.flow.xy.y-1017.0)<=24.0;
  if(overSwitch)c.reserved.x=c.flow.xy.x>=1804.0?1u:0u;
  else if(pointerActive){
   uint page=(c.state.x/3u)*3u;
   for(uint row=0u;row<3u;row++){
    uint index=page+row;if(index>=count)break;
    vec2 q=abs(c.flow.xy-vec2(960,551.0+float(row)*151.0))-vec2(642,44);
    if(min(max(q.x,q.y),0.0)+length(max(q,0.0))-18.0<=0.0){c.state.x=index;launchSelection();}
   }
  }
  else launchSelection();
 }
 // Completion is acknowledged by the host after a real folder rescan.
 if(c.refresh.x>0.0)c.refresh.y=mod(c.refresh.y+.14,6.28318530718);
 c.motion.y=float(c.state.x);c.motion.z=mix(c.motion.z,float(c.state.w),.13);
 // reserved.x is the light/dark target; transition.z eases towards it so the
 // fragment shader can cross-fade without any extra host work.
 c.transition.z=mix(c.transition.z,float(c.reserved.x!=0u),.18);c.state.y=buttons;
}
